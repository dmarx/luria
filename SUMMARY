    """What to type. Derived from `new.kinds()`, the same mapping the CLI
    dispatches on, so the command in this table is the command that works."""
    from .new import default_kind, kinds
    default = default_kind()
    rows = []
    for kind, (sort, target) in sorted(kinds().items()):
        if sort == "scheme":
            what = f"a document in the `{target.prefix}` scheme, numbered for you"
        elif sort == "journal":
            what = f"a dated entry in the `{target.name}` journal"
        elif sort == "fragment":
            what = f"a fragment in `{target}/`"
        else:
            what = "a migration spec"
        cmd = f'`luria new --kind {kind} --title "…"`'
        if kind == default:
            cmd += ' — or just `luria new --title "…"`, the default kind'
        rows.append([cmd, what])
    return _table(["command", "files"], rows)


def _flatten(prefix: str, value, depth: int) -> list[tuple[str, object]]:
    """`{"site": {"theme": {...}}}` as `site.theme`, and no deeper.

    `depth` stops at a settings table's own keys, which is where a *decision*
    lives. A theme is one choice with twenty-four colours in it; flattening all
    the way turns one changed setting into twenty-four rows and buries the
    other five."""
    if isinstance(value, dict) and depth > 0:
        out: list[tuple[str, object]] = []
        for k, v in value.items():
            out += _flatten(f"{prefix}.{k}" if prefix else k, v, depth - 1)
        return out
    return [(prefix, value)]


def _value(v) -> str:
    """A configured value as a reader would recognize it — a scalar as itself,
    a list spelled out, a nested table by the count that makes it one."""
    if isinstance(v, dict):
        return f"*{len(v)} key{'s' if len(v) != 1 else ''} set*" if v \
            else "*empty*"
    if isinstance(v, (list, tuple)):
        return ", ".join(f"`{x}`" for x in v) if v else "*empty*"
    if v == "":
        return "*empty*"
    return f"`{v}`"


#: Family tables describe themselves in the sections above; repeating their
#: keys here would be a third copy of the same fact.
FAMILIES = ("schemes", "fragments", "journals", "remotes")


def settings_section(cfg) -> str:
    """The settings this project moved off Luria's defaults, and nothing else.

    A diff, not a dump: a reader looking at a full key table cannot tell which
    rows were decided and which merely happened. Family tables are excluded —
    they *are* the sections above, and are replaced whole rather than merged
    (ADR-047), so "differs from the default" is not a meaningful question to
    ask of one."""
    sentinel = object()
    defaults = dict(_flatten("", config_mod.DEFAULTS, 2))
    rows = []
    for key, value in _flatten("", cfg._raw, 2):
        if key.split(".")[0] in FAMILIES:
            continue
        was = defaults.get(key, sentinel)
        if value == was:
            continue
        rows.append([f"`{key}`", _value(value),
                     "*unset*" if was is sentinel else _value(was)])
    if not rows:
        return ("*Every setting is at its default — the record's shape is "
                f"entirely in the families above. See the [schema]({SCHEMA_URL}) "
                "for what else can be set.*\n")
    return _table(["key", "this project", "Luria's default"], rows)


SECTIONS = (
    ("Referable documents",
     "A code — `ADR-012` — resolves to a document, and every reference to it "
     "in this repository is checked. `luria lint` fails on a bare code that "
     "was never linked; `luria link --fix` writes the link so nobody has to "
     "know where the document renders.",
     schemes_section),
    ("What an entry must carry",
     "Every entry carries `title`, `tags` and `date`, and one standard "
     "field is conditional: a retiring document names its successor — "
     "`superseded_by:` when `status` is `Superseded`, unless the scheme "
     "renames the pair (ADR-071). `status` itself is listed below rather "
     "than assumed: the words are the scheme's own, declared like any "
     "other controlled vocabulary. Beyond those, what each scheme's "
     "entries must carry — compiled from `luria.yaml` into the contract "
     "`luria lint` checks, with where each obligation was declared. A "
     "finding cites the same line.",
     contracts_section),
    ("Journals",
     "Dated observations. An entry is true about the day it was written and "
     "is never revised or consumed — the books are a view over sources that "
     "stay, which is what makes a journal safe to write into without "
     "coordinating.",
     journals_section),
    ("Fragment directories",
     "One file per contribution, assembled into a single document and then "
     "consumed. The point is the absence of a shared file to conflict on: "
     "every contributor writes a new path.",
     fragments_section),
    ("Other projects this record cites",
     "A prefixed code reaches into another project's record, so a citation "
     "says whose decision it is at the point of use rather than leaving the "
     "reader to guess.",
     remotes_section),
    ("Filing something new",
     "Every kind this project scaffolds, straight from the dispatch table "
     "`luria new` itself uses.",
     filing_section),
    ("Settings this project changed",
     "Everything not listed here is at Luria's default.",
     settings_section),
