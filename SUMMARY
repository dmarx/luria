        meta = read_document(path)[0]
        was = set(violations(contract, rel, meta, known))
        now = violations(contract, rel, _applied(meta, entries), known)
        fresh = [v for v in now if v not in was]
        if fresh:
            held_back += [(e, fresh[0]) for e in entries]
        else:
            safe += entries
