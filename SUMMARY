    d = tmp_path / "record" / "decisions.d"
    d.mkdir(parents=True)
    monkeypatch.setenv("LURIA_ROOT", str(tmp_path))
    config.reset()
    yield config.current().schemes["ADR"], d
    config.reset()


def _scheme(pair):
    return pair


