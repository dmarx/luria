    """Carried prose is a comment, not a value: the result still parses."""
    _commented(tmp_path)
    upgrade.run("yaml", root=str(tmp_path))
    (tmp_path / "luria.toml").unlink()
    monkeypatch.setenv("LURIA_ROOT", str(tmp_path))
