File: actions/site/action.yml
---
# The publishing third of the recommended docs workflow (ADR-029, ADR-042):
# stage the record as a Quartz vault, build it, and hand the caller a
# directory to upload. Like the generate and lint actions, this is the single
# authoritative implementation — luria's own Pages workflow and the template
# one both `uses:` it rather than restating the build.
#
# Caller contract:
#   - Check out the repository first, and set up Python (actions/setup-python).
#     Node is set up here, because the version is Quartz's requirement rather
#     than the caller's choice.
#   - Read the `path` output and hand it to actions/upload-pages-artifact.
#   - Enable Pages on the repository with "GitHub Actions" as the source. That
#     is a repository setting, not a file, and nothing in this action can do
#     it — the first deploy fails with "Pages is not enabled" until it is.
#
# Quartz is pinned to a tag rather than tracked: a static site generator that
# moves under you turns an unrelated merge into a broken publish, and the
# config this action writes is written against one version's plugin API.
#
# Quartz 5 reads `quartz.config.yaml`; its 45 `@quartz-community/*` plugins
# ship as ordinary dependencies, so `npm ci` installs them and the `prebuild`
# hook only matters to a project adding its own.
#
# inactive-ok-file: ADR-101 — Proposed. Named as the decision this
# action's Quartz pin and copy step were rewritten against; the citation
# is to its reasoning, not a claim it is settled.
name: luria site build
description: >-
  Stage the record with `luria site` and build it with a pinned Quartz, into a
  directory of static HTML ready for actions/upload-pages-artifact.
inputs:
  pip-spec:
    description: >-
      pip requirement spec used to install luria (e.g. "luria==0.1.2", or
      "-e ." inside luria's own repository). Empty string skips the install
      for callers that installed it already.
    default: luria
  quartz-repo:
    description: The Quartz repository to build with.
    default: jackyzha0/quartz
  quartz-ref:
    description: >-
      The Quartz commit to pin. Bump it deliberately: `luria site` writes a
      quartz.config.yaml against this version's plugin names and layout
      keys, and a major version moves both.

      A COMMIT rather than a tag, which is the one place this departs from
      ADR-042's "pinned to a tag". The newest tag is still v5.0.0, and that
      is the release ADR-042 measured as unbuildable — its plugin installer
      crashed on `.scss` under Node 22. The `v5` branch has since fixed it;
      this commit is the one a real build of this record was verified
      against (ADR-101). Move it to a tag once one ships past v5.0.0.
    default: f1fba3fc55cbf60a60a5d09c95a49c042cdab63a
  node-version:
    description: Node version. Quartz 5 requires 22 or newer (npm >= 10.9.2).
    default: "22"
outputs:
  path:
    description: Directory of built HTML, for actions/upload-pages-artifact.
    value: ${{ steps.build.outputs.path }}
runs:
  using: composite
  steps:
    - if: ${{ inputs.pip-spec != '' }}
      shell: bash
      run: pip install ${{ inputs.pip-spec }}
    - shell: bash
      run: luria site --out "$RUNNER_TEMP/luria-site"
    - uses: actions/checkout@v4
      with:
        repository: ${{ inputs.quartz-repo }}
        ref: ${{ inputs.quartz-ref }}
        path: .quartz-build
    - uses: actions/setup-node@v4
      with:
        node-version: ${{ inputs.node-version }}
        cache: npm
        cache-dependency-path: .quartz-build/package-lock.json
    - id: build
      shell: bash
      run: |
        set -euo pipefail
        # The vault replaces Quartz's own sample content wholesale; leaving it
        # would publish the generator's documentation alongside the record.
        rm -rf .quartz-build/content
        cp -r "$RUNNER_TEMP/luria-site/content" .quartz-build/content
        # One file since Quartz 5: it takes its layout from each plugin's own
        # `layout:` key, so there is no generated quartz.layout.ts any more.
        cp "$RUNNER_TEMP/luria-site/quartz.config.yaml" .quartz-build/quartz.config.yaml
        cp "$RUNNER_TEMP/luria-site/custom.scss" .quartz-build/quartz/styles/custom.scss
        # Merged, not replaced: Quartz ships its own og-image and giscus files
        # in here that the record has no opinion about.
        cp -r "$RUNNER_TEMP/luria-site/static/." .quartz-build/quartz/static/
        cd .quartz-build
        npm ci
        # The favicon is rasterized here rather than committed, so a project
        # points at the vector master it maintains and nothing derived from it
        # can drift. `sharp` is Quartz's own dependency — reading an SVG and
        # writing the `static/icon.png` that Head links and the Favicon
        # emitter resizes into favicon.ico — so this adds nothing to install.
        # Read the icon from the STAGING directory, never from the merged
        # `quartz/static` — that one already holds Quartz's own `icon.png`,
        # and asking the shell to choose between it and ours by globbing
        # picks the stock one, since `icon.png` sorts before `icon.svg`.
        #
        # A loop rather than `ls … | head -1`: with `pipefail` set, `ls` on a
        # pattern that matches nothing fails the whole pipeline and `set -e`
        # ends the step — so a project that configures no icon would get a
        # broken Pages build instead of the generator's default one (#73). An
        # unmatched glob expands to itself here, which `-e` rejects.
        ICON=""
        for candidate in "$RUNNER_TEMP"/luria-site/static/icon.*; do
          if [ -e "$candidate" ]; then ICON="$candidate"; break; fi
        done
        if [ -n "$ICON" ]; then
          node -e "
            const sharp = require('sharp');
            sharp('$ICON', { density: 384 })
              .resize(512, 512, { fit: 'contain',
                                  background: { r: 0, g: 0, b: 0, alpha: 0 } })
              .png()
              .toFile('quartz/static/icon.generated.png')
              .then(() => console.log('icon: rasterized $ICON'));
          "
          mv quartz/static/icon.generated.png quartz/static/icon.png
        fi
        npx quartz build --output "$RUNNER_TEMP/luria-site/public"
        echo "path=$RUNNER_TEMP/luria-site/public" >> "$GITHUB_OUTPUT"



