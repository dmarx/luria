    cited()
    before = citation.entry().splitlines()[0]
    cited(CFF + "version: 9.9.9\n")
    after = citation.entry()
    assert after.splitlines()[0] == before
    assert "version = {9.9.9}" in after, "the version still reaches the entry" 


