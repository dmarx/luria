    ("m.sh", "# dir: X\nf() {\n\n  echo hi\n}\n", (1, 2), (1, 5)),
    ("m.c", "/* dir: X */\nint f(void) {\n\n  return 1;\n}\n", (1, 2), (1, 5)),
