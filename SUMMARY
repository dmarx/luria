    root = project(tmp_path, monkeypatch, schemes=("RFC",))
    doc(root, "RFC", 1)
    doc(root, "RFC", 2)
    text = reports.pending_decisions(root / "docs")
    assert "## RFCs" not in text
    assert "RFC-001" in text and "RFC-002" in text


