    """Print, write, or check the README's citation region."""
    import sys
    target = readme()
    if not target.exists() or OPEN not in (text := target.read_text(encoding="utf-8")):
        print(f"luria citation: no {OPEN} region in README.md; nothing to do")
        return
    fresh = rewrite(text)
    if check:
