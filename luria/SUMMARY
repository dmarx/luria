            # numeric one is spelled canonically, zero-padded.
            if self.code:
                return f"{self.prefix}-{self.code}"
            return f"{self.prefix}-{self.num:03d}"
        if self.kind == "remote":
            return self.text or f"{self.remote}-{self.code}"
        return f"#{self.num}"


