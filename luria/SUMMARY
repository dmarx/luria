            print("luria citation: the README's citation region is stale — "
                  "run `luria index`", file=sys.stderr)
            raise SystemExit(1)
        return
    if write:
        target.write_text(fresh, encoding="utf-8")
        return
    print(region())


if __name__ == "__main__":
    import fire
    fire.Fire(run)



