// luria/patterns.lark
// A path pattern: the subset of Cypher's pattern syntax a record may
// declare (the ADR on chains walking a named path pattern). This grammar
// IS the subset — widening it is a change to this file, the lowering in
// `pattern_rules.py` and that decision together. `patterns.py` names the
// constructs it refuses; a parse failure reaching it unnamed gets a column.

start: path (_WHERE _NOT path)*

path: node (edge node)*

node: "(" [NAME] [":" NAME] [props] [test] ")"
props: "{" prop ("," prop)* "}"
prop: NAME ":" literal

// One comparison on one field of the node itself, in Cypher's inline
// node predicate: `(p:CLAIM WHERE p.status <> 'Active')`. Equality stays
// the property map; this admits only what the map cannot say.
test: _WHERE NAME "." NAME "<>" literal        -> unequal
    | _WHERE NAME "." NAME _IN list            -> within
    | _WHERE _NOT NAME "." NAME _IN list       -> without
list: "[" literal ("," literal)* "]"
literal: STRING | INT

// An edge variable is accepted here only so it can be refused by name.
edge: "-[" [NAME] types [length] "]->"     -> right
    | "<-[" [NAME] types [length] "]-"     -> left
types: ":" NAME ("|" NAME)*
length: "*" [INT] [RANGE [INT]]

_WHERE: /where/i
_NOT.2: /not\b/i
_IN.2: /in\b/i
RANGE: ".."
NAME: /[A-Za-z_][A-Za-z0-9_]*/
STRING: /'[^']*'/ | /"[^"]*"/
%import common.INT
%import common.WS
%ignore WS
