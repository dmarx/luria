  #
  # A DEFAULT, not a law: rename these, drop the ones you do not want,
  # add your own. Every check reads this. The one rule is that a
  # scheme's `active` word has to appear here — it is how everything
  # decides what is in force, so a vocabulary without it means no
  # document ever is.
  #
  # Named once and referenced by every scheme that uses it, so two
  # schemes sharing a vocabulary cannot drift apart (ADR-tmp8hp25).
  statuses:
    Active:
      blurb: in force — the current answer, and what a citation should normally point at
    Proposed:
      blurb: not in force yet — an open question, so citing it as settled is the thing the report catches
    Deferred:
      blurb: not in force and not being worked on; the question is real and the answer is waiting on something
    Superseded:
      blurb: no longer in force because something replaced it; the successor is named in the field, not the prose
    Rejected:
      blurb: no longer in force and nothing replaced it — kept because a rejection is worth being able to point at
  adr-tags:
    record:
      label: The record
