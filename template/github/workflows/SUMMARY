File: template/.github/workflows/pages.yml
---
# Publish the record as a browsable site on GitHub Pages (LU-ADR-042).
#
# `luria site` stages every page the record publishes — the decisions, the
# principles document, the devlog books, the reports — with paths preserved,
# so the relative links `luria link --fix` already wrote keep resolving. The
# composite action builds that vault with a pinned Quartz, which gives the
# citations a graph and backlinks without anyone maintaining either.
#
# The site is built from the committed views, so it builds after the job
# that commits them: `workflow_run` fires when the Docs workflow completes on
# the default branch, by which time its generation job has pushed the
# regenerated views, and the checkout is the head of the default branch. A
# pull request builds nothing — a branch carries no views of its own
# (LU-ADR-068). If you rename the Docs workflow, rename it here too.
#
# Before the first deploy succeeds, set Settings → Pages → Source to
# "GitHub Actions". That is a repository setting; no file in the repository
# can turn it on, and until it is on the `deploy` job fails with "Pages is
# not enabled" while `build` stays green.
#
# Delete this file if you would rather not publish. Nothing else depends on
# it — `luria site` is a build step, and the record it reads is the record
# every other command reads.
name: Pages

on:
  workflow_run:
    workflows: [Docs]
    types: [completed]
    branches: [main]
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: pages
  cancel-in-progress: false

jobs:
  build:
    # A Docs run that failed has no regenerated views to publish.
    if: github.event_name != 'workflow_run' || github.event.workflow_run.conclusion == 'success'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - id: site
        # Pin a released tag once you depend on this in anger.
        uses: dmarx/luria/actions/site@main
      - uses: actions/upload-pages-artifact@v3
        with:
          path: ${{ steps.site.outputs.path }}

  # Separate from the build because it is the only job that needs to write.
  deploy:
    needs: build
    runs-on: ubuntu-latest
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: ${{ steps.deploy.outputs.page_url }}
    steps:
      - id: deploy
        uses: actions/deploy-pages@v4


