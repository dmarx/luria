    root = project(tmp_path, monkeypatch, schemes=("SPEC", "RFC"))
    doc(root, "RFC", 1)
    doc(root, "SPEC", 1)
    text = reports.pending_decisions(root / "docs")
    assert text.index("## SPECs") < text.index("## RFCs")


