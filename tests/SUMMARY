    (root / "record" / "principles.d").mkdir(parents=True)
    (root / "luria.toml").write_text(COMMENTED)
    (root / "record" / "decisions.d" / "statuses.yaml").write_text(
        COMMENTED_WORDS)
    (root / "record" / "principles.d" / "statuses.yaml").write_text(
        COMMENTED_WORDS)


