from pathlib import Path

from _scheme import decision

from luria import badges, config

REPO = Path(__file__).resolve().parents[1]

TWO_SCHEMES = (
    """
issue_url: https://example.test/issues/{n}
schemes:
  ADR:
    dir: docs/decisions
  VP:
    dir: docs/values
    render: document
    output: docs/values.md
"""
)


